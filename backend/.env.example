# --- Database ---
# Local testing (default): SQLite file in the backend folder
DATABASE_URL=sqlite:///./website_promotion.db
# On Render, DATABASE_URL is injected automatically by render.yaml (linked
# to the website-offer-db Postgres instance) — you won't set this by hand
# there. For manual/other hosts:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# --- CORS: comma-separated list of allowed frontend origins ---
# Locally: the Vite dev server / preview origins. In production (Render):
# the deployed Vercel frontend's URL(s), e.g.
# https://website-offer.manojrashinkar.com,https://website-offer.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Admin API protection ---
# Long random string. Admin endpoints return 503 until this is set.
# When integrating into your portal, replace token auth with your existing auth dependency
# (see app/routers/admin.py -> require_admin).
ADMIN_API_TOKEN=

# --- Anti-spam ---
RATE_LIMIT_MAX_SUBMISSIONS=5
RATE_LIMIT_WINDOW_MINUTES=60
DUPLICATE_WINDOW_HOURS=24

# --- Business identity (used in API responses, never hardcode in code) ---
BUSINESS_NAME=Your Business Name
CONTACT_EMAIL=you@example.com
CONTACT_PHONE=+91XXXXXXXXXX
BUSINESS_LOCATION=Your City, State
