# --- API ---
# Frontend (Vercel) and backend (Render) are separate deployments/origins,
# so this must point at the deployed backend's full URL, e.g.
# https://website-offer-api.onrender.com — no trailing slash.
# Leave empty only for local dev, where Vite's dev-server proxy (see
# vite.config.ts) forwards /api to http://127.0.0.1:8000 instead.
VITE_API_BASE_URL=
# Endpoint the enquiry form posts to (relative to VITE_API_BASE_URL).
VITE_ENQUIRY_API_URL=/api/website-enquiry

# --- Route for the promotional page ---
# Set to "/" when this app has its own dedicated subdomain (e.g.
# website-offer.manojrashinkar.com). Set to "/business-website-offer" if it's
# nested inside a larger portal instead.
VITE_OFFER_ROUTE=/

# --- WhatsApp ---
VITE_WHATSAPP_NUMBER=91XXXXXXXXXX

# --- Business identity (placeholders — fill with real values, never hardcode in code) ---
# Leave VITE_BUSINESS_NAME blank until a business name is decided — the
# header/footer gracefully omit it rather than showing a placeholder.
VITE_BUSINESS_NAME=
VITE_SITE_DOMAIN=https://website-offer.manojrashinkar.com
VITE_CONTACT_EMAIL=you@example.com
VITE_CONTACT_PHONE=+91XXXXXXXXXX
VITE_BUSINESS_LOCATION=Your City, State

# --- Optional social / legal links (leave empty to hide) ---
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
VITE_PORTFOLIO_URL=
VITE_PRIVACY_POLICY_URL=/privacy-policy
VITE_TERMS_URL=/terms

# --- SEO (used in index.html meta tags at build time) ---
VITE_SEO_TITLE=Professional Business Website Development
VITE_SEO_DESCRIPTION=Apply for professional business website development with mobile-responsive design, enquiry forms, WhatsApp integration and deployment support.
VITE_OG_IMAGE_URL=/og-image.png
