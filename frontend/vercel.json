{
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "webservices.manojrashinkar.com" }],
      "destination": "/robots-webservices.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots-main.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "webservices.manojrashinkar.com" }],
      "destination": "/sitemap-webservices.xml"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-main.xml"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
